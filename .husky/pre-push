#!/bin/sh
valid_branch_regex="^(feat|fix|test|refactor|perf|chore|docs|ci|hotfix)/((FMMS-[0-9]+-)?[a-z0-9-]+)$"
zero_sha="0000000000000000000000000000000000000000"

validate_branch() {
  branch="$1"
  if [ -z "$branch" ]; then
    return 0
  fi

  if [ "$branch" = "main" ]; then
    echo "❌ Direct push to 'main' is blocked. Please branch off and open a Pull Request."
    exit 1
  fi

  if ! echo "$branch" | grep -Eq "$valid_branch_regex"; then
    echo "❌ Invalid branch name: '$branch'"
    echo "Branch names must follow: <type>/<FMMS-TICKET>-<description> or <type>/<description>"
    echo "Allowed types: feat, fix, test, refactor, perf, chore, docs, ci, hotfix"
    echo "Example: feat/FMMS-12-prayer-notifications"
    exit 1
  fi
}

saw_ref=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "$local_ref" ]; then
    continue
  fi
  saw_ref=1

  # Allow branch deletions
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  case "$remote_ref" in
    refs/heads/*)
      remote_branch="${remote_ref#refs/heads/}"
      if [ "$remote_branch" = "gh-pages" ]; then
        continue
      fi
      validate_branch "$remote_branch"
      ;;
  esac
done

if [ "$saw_ref" -eq 0 ]; then
  branch="$(git symbolic-ref --short HEAD 2>/dev/null)"
  validate_branch "$branch"
fi
